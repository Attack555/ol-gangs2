        <rect x="206" y="226" width="9" height="20" rx="2"/><rect x="216" y="226" width="9" height="22" rx="2"/><rect x="226" y="226" width="9" height="23" rx="2"/><rect x="236" y="226" width="9" height="23" rx="2"/><rect x="246" y="226" width="9" height="23" rx="2"/><rect x="256" y="226" width="9" height="22" rx="2"/><rect x="266" y="226" width="9" height="20" rx="2"/>
