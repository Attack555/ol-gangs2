function delGang(id){
  if(!needPerm('add_gang')||!confirm(t('confirm')))return;
  DB.players.forEach(p=>{if(p.gangId===id){p.gangId=null;p.leftAt=now();p.holdUntil=now()+CONFIG.HOLD_DAYS*DAY;p.holdKind='leave'}});
  DB.gangs=DB.gangs.filter(g=>g.id!==id);save();go('gangs');
}
function addMember(gid){
  if(!canManage(gid)){toast(t('noPerm'));return}
  modal(t('addMember'),[{k:'name',label:t('name')},{k:'discord',label:t('discordId')}],o=>{
    const name=o.name.trim();if(!name)return false;
    if(members(gid).length>=CONFIG.MAX_MEMBERS){toast(t('gangFull'));return false}
    let p=DB.players.find(x=>x.name.toLowerCase()===name.toLowerCase()||(o.discord&&x.discord===o.discord));
    if(p){
      if(p.gangId){toast(t('alreadyIn'));return false}
      if(isBL(p)){toast(t('inBlacklist'));return false}
      if(p.holdKind==='leave'&&p.holdUntil>now()){toast(`${t('inHold')} ${fmt(p.holdUntil)}`);return false}
    }else{
      p={id:uid(),name,discord:o.discord||'',gangId:null,joinedAt:0,leftAt:null,holdUntil:0,holdKind:null,raids:0,wins:0,losses:0,kills:0,deaths:0};DB.players.push(p);
    }
    p.gangId=gid;p.joinedAt=now();p.holdUntil=now()+CONFIG.HOLD_DAYS*DAY;p.holdKind='join';
    save();render();toast(t('done'));
  });
}
function removeMember(pid){
  const p=playerById(pid);if(!canManage(p.gangId)){toast(t('noPerm'));return}
  if(!confirm(t('confirm')))return;
  p.gangId=null;p.leftAt=now();p.holdUntil=now()+CONFIG.HOLD_DAYS*DAY;p.holdKind='leave';save();render();
}

