function recordMatch(){
  if(!needPerm('record_match'))return;
  const opts=DB.gangs.map(g=>({v:g.id,l:g.name}));
  if(opts.length<2)return;
  modal(t('recordMatch'),[
    {k:'a',label:t('gangA'),type:'select',options:opts,value:opts[0].v},
    {k:'b',label:t('gangB'),type:'select',options:opts,value:opts[1].v},
    {k:'w',label:t('winner'),type:'select',options:[{v:'a',l:t('gangA')},{v:'b',l:t('gangB')}]},
    {k:'xpWin',label:t('xpWin'),type:'number',value:100},{k:'xpLose',label:t('xpLose'),type:'number',value:25}
  ],o=>{
    if(o.a===o.b){toast('A ≠ B');return false}
    const A=gangById(o.a),B=gangById(o.b),W=o.w==='a'?A:B,L=o.w==='a'?B:A;
    W.wins++;L.losses++;W.xp+=+o.xpWin||0;L.xp+=+o.xpLose||0;
    DB.matches.push({id:uid(),a:A.id,b:B.id,aName:A.name,bName:B.name,winnerName:W.name,xpWin:+o.xpWin||0,xpLose:+o.xpLose||0,at:now()});
    save();view.tab='2';render();toast(t('done'));
  });
}

