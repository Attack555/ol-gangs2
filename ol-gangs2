<script>
/* ============ CONFIG ============ */
const CONFIG = {
  API_URL: '',              // رابط الـ Backend (Node/Express مثلاً) لربط FiveM والداتابيس
  DISCORD_LOGIN_URL: '',    // رابط تسجيل دخول ديسكورد OAuth2 من الـ Backend
  HOLD_DAYS: 14,
  MAX_MEMBERS: 30,
  XP_PER_LEVEL: 500
};

/* ============ I18N ============ */
const I18N = {
 ar:{
  dash:'الرئيسية',gangs:'العصابات',players:'اللاعبين',results:'الفوزات والخسارات',discord:'لوحة الديسكورد',
  theme:'الثيم',sky:'سماوي غامق',white:'أبيض',black:'أسود',language:'اللغة',data:'البيانات',reset:'إعادة بيانات التجربة',
  login:'دخول بالديسكورد',logout:'خروج',heroP:'نظام إدارة العصابات لسيرفر فايف إم: النقاط، المستويات، الفوزات، الخسارات، الهولد والبلاك لست في مكان واحد.',
  gangsCount:'عدد العصابات',membersTotal:'إجمالي الأعضاء',winsTotal:'إجمالي الفوزات',matchesTotal:'عدد النتائج',
  leaderboard:'ترتيب العصابات',rank:'#',gang:'العصابة',level:'اللفل',xp:'الإكسبي',wins:'فوزات',losses:'خسارات',members:'الأعضاء',
  topKillers:'أفضل القتلة',kills:'ذبحات',deaths:'مرات الموت',raids:'ريدات شارك',kd:'K/D',name:'الاسم',
  addGang:'إضافة عصابة',gangName:'اسم العصابة',color:'اللون',deleteGang:'حذف العصابة',confirm:'متأكد؟',
  gangPanel:'لوحة العصابة',back:'رجوع',editStats:'تعديل الإحصائيات',addMember:'إضافة عضو',remove:'إزالة',
  discordId:'ايدي الديسكورد',joined:'تاريخ الدخول',hold:'الهولد',actions:'إجراءات',noMembers:'لا يوجد أعضاء',
  profile:'الملف الشخصي',search:'بحث...',noGang:'بدون عصابة',blacklisted:'بلاك لست',
  holdJoin:'هولد من الدخول',holdLeave:'هولد من الخروج',daysLeft:'يوم متبقي',noHold:'لا يوجد',until:'حتى',
  tab1:'ملخص',tab2:'سجل النتائج',tab3:'الفوزات والخسارات',recordMatch:'تسجيل نتيجة',gangA:'العصابة الأولى',gangB:'العصابة الثانية',winner:'الفائز',
  xpWin:'إكسبي الفائز',xpLose:'إكسبي الخاسر',date:'التاريخ',result:'النتيجة',vs:'ضد',won:'فاز',
  roles:'الرتب والصلاحيات',staff:'المسؤولين',blacklist:'البلاك لست',holdList:'الهولد',addRole:'إضافة رتبة',roleName:'اسم الرتبة',perms:'الصلاحيات',
  addStaff:'إضافة مسؤول',role:'الرتبة',reason:'السبب',by:'بواسطة',addBL:'إضافة بلاك لست',
  fridayOnly:'إضافة وإزالة البلاك لست متاحة يوم الجمعة فقط.',fridayOk:'اليوم جمعة، يمكنك إضافة وإزالة البلاك لست.',fridayNo:'اليوم ليس جمعة، الإضافة والإزالة مقفلة.',
  demoFriday:'وضع التجربة: اعتبار اليوم جمعة',
  noPerm:'ما عندك صلاحية لهذا الإجراء.',needLogin:'سجل دخولك أولاً.',
  save:'حفظ',cancel:'إلغاء',delete:'حذف',edit:'تعديل',
  gangFull:'العصابة وصلت الحد الأقصى (30).',inBlacklist:'اللاعب في البلاك لست.',inHold:'اللاعب عليه هولد حتى',alreadyIn:'اللاعب موجود في عصابة.',
  done:'تم',demoLogin:'تسجيل دخول تجريبي',pickRole:'اختر رتبتك',yourName:'اسمك',yourGang:'عصابتك (للقائد)',
  p_add_gang:'إضافة عصابات جديدة',p_manage_roles:'إنشاء الرتب',p_assign_roles:'إضافة رتب للمسؤولين',p_blacklist:'إدارة البلاك لست',p_record_match:'تسجيل النتائج',p_edit_stats:'تعديل الإحصائيات',p_manage_members:'إدارة أعضاء كل العصابات',p_manage_members_own:'إدارة أعضاء عصابته فقط',
  deny:'هذه الصفحة للمسؤولين فقط.',apiNote:'الربط مع ديسكورد وسكربت فايف إم يحتاج Backend (مفعّل من CONFIG). حالياً البيانات تجريبية محفوظة في المتصفح.',
  blSince:'منذ',liftBL:'إزالة',total:'الإجمالي'
 },
 en:{
  dash:'Home',gangs:'Gangs',players:'Players',results:'Wins & Losses',discord:'Discord Panel',
  theme:'Theme',sky:'Dark Sky',white:'White',black:'Black',language:'Language',data:'Data',reset:'Reset demo data',
  login:'Login with Discord',logout:'Logout',heroP:'Gang management for your FiveM server: XP, levels, wins, losses, holds and blacklist in one place.',
  gangsCount:'Gangs',membersTotal:'Total members',winsTotal:'Total wins',matchesTotal:'Results logged',
  leaderboard:'Gang leaderboard',rank:'#',gang:'Gang',level:'Level',xp:'XP',wins:'Wins',losses:'Losses',members:'Members',
  topKillers:'Top killers',kills:'Kills',deaths:'Deaths',raids:'Raids joined',kd:'K/D',name:'Name',
  addGang:'Add gang',gangName:'Gang name',color:'Color',deleteGang:'Delete gang',confirm:'Are you sure?',
  gangPanel:'Gang panel',back:'Back',editStats:'Edit stats',addMember:'Add member',remove:'Remove',
  discordId:'Discord ID',joined:'Joined',hold:'Hold',actions:'Actions',noMembers:'No members',
  profile:'Profile',search:'Search...',noGang:'No gang',blacklisted:'Blacklisted',
  holdJoin:'Join hold',holdLeave:'Leave hold',daysLeft:'days left',noHold:'None',until:'until',
  tab1:'Summary',tab2:'Match log',tab3:'Wins & Losses',recordMatch:'Record result',gangA:'Gang A',gangB:'Gang B',winner:'Winner',
  xpWin:'Winner XP',xpLose:'Loser XP',date:'Date',result:'Result',vs:'vs',won:'won',
  roles:'Roles & permissions',staff:'Staff',blacklist:'Blacklist',holdList:'Holds',addRole:'Add role',roleName:'Role name',perms:'Permissions',
  addStaff:'Add staff',role:'Role',reason:'Reason',by:'By',addBL:'Add to blacklist',
  fridayOnly:'Blacklist add/remove is allowed on Fridays only.',fridayOk:'It is Friday: you can add and remove blacklist entries.',fridayNo:'Not Friday: add/remove is locked.',
  demoFriday:'Demo mode: treat today as Friday',
  noPerm:'You do not have permission.',needLogin:'Please log in first.',
  save:'Save',cancel:'Cancel',delete:'Delete',edit:'Edit',
  gangFull:'Gang is full (30 max).',inBlacklist:'Player is blacklisted.',inHold:'Player is on hold until',alreadyIn:'Player is already in a gang.',
  done:'Done',demoLogin:'Demo login',pickRole:'Pick your role',yourName:'Your name',yourGang:'Your gang (leaders)',
  p_add_gang:'Add new gangs',p_manage_roles:'Create roles',p_assign_roles:'Assign roles to staff',p_blacklist:'Manage blacklist',p_record_match:'Record results',p_edit_stats:'Edit stats',p_manage_members:'Manage all gang members',p_manage_members_own:'Manage own gang members',
  deny:'This page is for staff only.',apiNote:'Discord and FiveM integration requires a backend (set in CONFIG). Data here is demo data stored in your browser.',
  blSince:'since',liftBL:'Remove',total:'Total'
 }
};

/* ============ STATE ============ */
const KEY='olgangs_v1', SKEY='olgangs_session', PKEY='olgangs_prefs';
const DAY=86400000, now=()=>Date.now(), uid=()=>Math.random().toString(36).slice(2,9);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const PERMS=['add_gang','manage_roles','assign_roles','blacklist','record_match','edit_stats','manage_members','manage_members_own'];

let prefs=JSON.parse(localStorage.getItem(PKEY)||'{"theme":"sky","lang":"ar","demoFriday":false}');
let session=JSON.parse(localStorage.getItem(SKEY)||'null');
let DB=load();
let view={page:'dash',id:null,tab:'1',dtab:'roles',q:''};

function seed(){
  const g=(name,color,xp,w,l)=>({id:uid(),name,color,xp,wins:w,losses:l});
  const gangs=[g('Black Wolves','#29b6f6',2350,14,5),g('Silver Vipers','#b0b6bd',1720,10,7),g('Red Dragons','#ff5d6c',1180,7,9),g('Night Kings','#a78bfa',640,3,8)];
  const names=['Faisal','Khalid','Sultan','Nawaf','Turki','Saad','Majed','Fahad','Rakan','Bader','Mishari','Abdullah'];
  const players=[];
  names.forEach((n,i)=>{const gi=i%4;players.push({id:uid(),name:n,discord:'',gangId:gangs[gi].id,joinedAt:now()-(i*3+2)*DAY,leftAt:null,holdUntil:now()-(i*3+2)*DAY+CONFIG.HOLD_DAYS*DAY,holdKind:'join',raids:5+i*2,wins:2+i,losses:i%3,kills:20+i*7,deaths:10+i*3});});
  return{gangs,players,blacklist:[],matches:[],
    roles:[
      {id:'mafia',name:'مسؤول المافيا',color:'#ffc857',perms:[...PERMS]},
      {id:'admin',name:'مسؤول',color:'#29b6f6',perms:['blacklist','record_match','edit_stats','manage_members']},
      {id:'leader',name:'قائد عصابة',color:'#3ddc97',perms:['manage_members_own']},
      {id:'member',name:'عضو',color:'#8d8d8d',perms:[]}],
    staff:[{id:uid(),name:'Mafia Boss',discord:'',roleId:'mafia'},{id:uid(),name:'Admin One',discord:'',roleId:'admin'}]};
}
function load(){try{const d=JSON.parse(localStorage.getItem(KEY));if(d&&d.gangs)return d}catch(e){}const d=seed();localStorage.setItem(KEY,JSON.stringify(d));return d}
function save(){localStorage.setItem(KEY,JSON.stringify(DB))}
function resetData(){if(!confirm(t('confirm')))return;DB=seed();save();go('dash')}

const t=k=>(I18N[prefs.lang]&&I18N[prefs.lang][k])||k;
const role=()=>session?DB.roles.find(r=>r.id===session.roleId):null;
const can=p=>{const r=role();return !!(r&&r.perms.includes(p))};
const isFriday=()=>prefs.demoFriday||new Date().getDay()===5;
const level=xp=>Math.floor(xp/CONFIG.XP_PER_LEVEL)+1;
const gangById=id=>DB.gangs.find(g=>g.id===id);
const playerById=id=>DB.players.find(p=>p.id===id);
const members=gid=>DB.players.filter(p=>p.gangId===gid);
const fmt=ts=>new Date(ts).toLocaleDateString(prefs.lang==='ar'?'ar-SA-u-nu-latn':'en-GB',{year:'numeric',month:'short',day:'numeric'});
const kd=p=>(p.deaths?(p.kills/p.deaths):p.kills).toFixed(2);
const isBL=p=>DB.blacklist.some(b=>b.playerId===p.id);
function canManage(gid){return can('manage_members')||(can('manage_members_own')&&session&&session.gangId===gid)}

/* ============ UI HELPERS ============ */
function toast(m){const d=document.createElement('div');d.className='toast';d.textContent=m;document.body.appendChild(d);setTimeout(()=>d.remove(),2200)}
function modal(title,fields,onOk,extraHtml=''){
  const bg=document.createElement('div');bg.className='modal-bg';
  const f=fields.map(x=>{
    if(x.type==='select')return`<label>${x.label}</label><select name="${x.k}">${x.options.map(o=>`<option value="${esc(o.v)}" ${o.v==x.value?'selected':''}>${esc(o.l)}</option>`).join('')}</select>`;
    if(x.type==='checks')return`<label>${x.label}</label>${x.options.map(o=>`<div class="chk"><input type="checkbox" name="${x.k}" value="${o.v}" ${(x.value||[]).includes(o.v)?'checked':''}>${esc(o.l)}</div>`).join('')}`;
    return`<label>${x.label}</label><input name="${x.k}" type="${x.type||'text'}" value="${esc(x.value??'')}">`}).join('');
  bg.innerHTML=`<form class="modal"><h3>${title}</h3>${extraHtml}${f}<div class="row" style="margin-top:18px"><button class="btn" type="submit">${t('save')}</button><button class="btn ghost" type="button" id="mc">${t('cancel')}</button></div></form>`;
  document.body.appendChild(bg);
  bg.querySelector('#mc').onclick=()=>bg.remove();
  bg.addEventListener('mousedown',e=>{if(e.target===bg)bg.remove()});
  bg.querySelector('form').onsubmit=e=>{e.preventDefault();const fd=new FormData(e.target),o={};
    fields.forEach(x=>{o[x.k]=x.type==='checks'?fd.getAll(x.k):fd.get(x.k)});
    if(onOk(o)!==false)bg.remove()};
}
function needPerm(p){if(!session){toast(t('needLogin'));return false}if(!can(p)){toast(t('noPerm'));return false}return true}

/* ============ ROUTER / RENDER ============ */
function go(page,id=null){view.page=page;view.id=id;view.tab='1';render();window.scrollTo(0,0)}
function render(){
  document.documentElement.dataset.theme=prefs.theme;
  document.documentElement.lang=prefs.lang;
  document.documentElement.dir=prefs.lang==='ar'?'rtl':'ltr';
  document.querySelectorAll('[data-i18n]').forEach(e=>e.textContent=t(e.dataset.i18n));
  document.querySelectorAll('#themeOpts button').forEach(b=>b.classList.toggle('on',b.dataset.th===prefs.theme));
  document.querySelectorAll('#langOpts button').forEach(b=>b.classList.toggle('on',b.dataset.lg===prefs.lang));
  const items=[['dash','dash'],['gangs','gangs'],['players','players'],['results','results'],['discord','discord']];
  document.getElementById('nav').innerHTML=items.map(([p,k])=>`<button class="${(view.page===p||(p==='gangs'&&view.page==='gang')||(p==='players'&&view.page==='profile'))?'active':''}" onclick="go('${p}')">${t(k)}</button>`).join('');
  document.getElementById('userBox').innerHTML=session
    ?`<span class="badge" style="border-color:${role()?.color}">${esc(session.name)} · ${esc(role()?.name||'')}</span> <button class="btn ghost sm" onclick="logout()">${t('logout')}</button>`
    :`<button class="btn" onclick="login()">${t('login')}</button>`;
  const app=document.getElementById('app');
  const P={dash:pDash,gangs:pGangs,gang:pGang,players:pPlayers,profile:pProfile,results:pResults,discord:pDiscord};
  app.innerHTML=(P[view.page]||pDash)();
}
function toggleMenu(){document.getElementById('menu').classList.toggle('open')}
document.addEventListener('click',e=>{
  const m=document.getElementById('menu');
  if(!e.target.closest('.right'))m.classList.remove('open');
  const th=e.target.closest('[data-th]');if(th){prefs.theme=th.dataset.th;savePrefs();render()}
  const lg=e.target.closest('[data-lg]');if(lg){prefs.lang=lg.dataset.lg;savePrefs();render()}
});
function savePrefs(){localStorage.setItem(PKEY,JSON.stringify(prefs))}

