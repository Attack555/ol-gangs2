    const fr=isFriday();
    body=`<div class="notice ${fr?'ok':'bad'}">${t('fridayOnly')} — ${fr?t('fridayOk'):t('fridayNo')}
      <div class="chk" style="margin-top:8px"><input type="checkbox" ${prefs.demoFriday?'checked':''} onchange="prefs.demoFriday=this.checked;savePrefs();render()">${t('demoFriday')}</div></div>
    <h2>${t('blacklist')} ${can('blacklist')?`<button class="btn" onclick="addBL()">+ ${t('addBL')}</button>`:''}</h2>
    ${DB.blacklist.length?`<div class="wrap"><table class="tbl"><tr><th>${t('name')}</th><th>${t('reason')}</th><th>${t('by')}</th><th>${t('date')}</th><th></th></tr>
    ${DB.blacklist.map(b=>`<tr><td>${esc(playerById(b.playerId)?.name||'?')}</td><td>${esc(b.reason)}</td><td>${esc(b.by)}</td><td>${fmt(b.at)}</td><td>${can('blacklist')?`<button class="btn ghost sm" onclick="liftBL('${b.id}')">${t('liftBL')}</button>`:''}</td></tr>`).join('')}</table></div>`:`<div class="card empty">—</div>`}`;
  }else{
    const hs=DB.players.filter(p=>p.holdUntil>now());
    body=`<h2>${t('holdList')}</h2>${hs.length?`<div class="wrap"><table class="tbl"><tr><th>${t('name')}</th><th>${t('gang')}</th><th>${t('hold')}</th><th>${t('until')}</th></tr>
    ${hs.map(p=>`<tr class="click" onclick="go('profile','${p.id}')"><td>${esc(p.name)}</td><td>${esc(gangById(p.gangId)?.name||'—')}</td><td>${holdBadge(p)}</td><td>${fmt(p.holdUntil)}</td></tr>`).join('')}</table></div>`:`<div class="card empty">—</div>`}`;
  }
  return`<div class="notice">${t('apiNote')}</div>${tabs}${body}`;
}
const permOpts=()=>PERMS.map(p=>({v:p,l:t('p_'+p)}));
function addRole(){
  if(!needPerm('manage_roles'))return;
  modal(t('addRole'),[{k:'name',label:t('roleName')},{k:'color',label:t('color'),type:'color',value:'#29b6f6'},{k:'perms',label:t('perms'),type:'checks',options:permOpts(),value:[]}],o=>{
    if(!o.name.trim())return false;DB.roles.push({id:uid(),name:o.name.trim(),color:o.color,perms:o.perms});save();render()});
}
function editRole(id){
  if(!needPerm('manage_roles'))return;const r=DB.roles.find(x=>x.id===id);
  modal(t('edit'),[{k:'name',label:t('roleName'),value:r.name},{k:'color',label:t('color'),type:'color',value:r.color},{k:'perms',label:t('perms'),type:'checks',options:permOpts(),value:r.perms}],o=>{
    r.name=o.name.trim()||r.name;r.color=o.color;r.perms=o.perms;save();render()});
}
function delRole(id){
  if(!needPerm('manage_roles')||!confirm(t('confirm')))return;
  DB.staff.forEach(s=>{if(s.roleId===id)s.roleId='member'});DB.roles=DB.roles.filter(r=>r.id!==id);save();render();
}
function addStaff(){
  if(!needPerm('assign_roles'))return;
  modal(t('addStaff'),[{k:'name',label:t('name')},{k:'discord',label:t('discordId')},{k:'roleId',label:t('role'),type:'select',options:DB.roles.map(r=>({v:r.id,l:r.name}))}],o=>{
    if(!o.name.trim())return false;DB.staff.push({id:uid(),name:o.name.trim(),discord:o.discord,roleId:o.roleId});save();render()});
}
function setStaffRole(id,rid){if(!needPerm('assign_roles'))return render();DB.staff.find(s=>s.id===id).roleId=rid;save();render()}
function delStaff(id){if(!needPerm('assign_roles')||!confirm(t('confirm')))return;DB.staff=DB.staff.filter(s=>s.id!==id);save();render()}

function addBL(){
  if(!needPerm('blacklist'))return;
  if(!isFriday()){toast(t('fridayNo'));return}
  modal(t('addBL'),[{k:'name',label:t('name')},{k:'reason',label:t('reason')}],o=>{
    const n=o.name.trim();if(!n)return false;
    let p=DB.players.find(x=>x.name.toLowerCase()===n.toLowerCase());
    if(!p){p={id:uid(),name:n,discord:'',gangId:null,joinedAt:0,leftAt:null,holdUntil:0,holdKind:null,raids:0,wins:0,losses:0,kills:0,deaths:0};DB.players.push(p)}
    if(isBL(p)){toast(t('inBlacklist'));return false}
    if(p.gangId){p.gangId=null;p.leftAt=now();p.holdUntil=now()+CONFIG.HOLD_DAYS*DAY;p.holdKind='leave'}
    DB.blacklist.push({id:uid(),playerId:p.id,reason:o.reason,by:session.name,at:now()});save();render();toast(t('done'));
  });
}
function liftBL(id){
  if(!needPerm('blacklist'))return;
  if(!isFriday()){toast(t('fridayNo'));return}
  if(!confirm(t('confirm')))return;
  DB.blacklist=DB.blacklist.filter(b=>b.id!==id);save();render();
}

/* ============ FIVEM / DISCORD HOOKS (للربط مع الباك إند) ============ */
// مثال: استدعِ هذه الدالة من الـ Backend/WebSocket عند حدوث قتل أو مشاركة ريد داخل السيرفر.
window.OLGANGS={
  kill(killerName,victimName){const k=DB.players.find(p=>p.name===killerName),v=DB.players.find(p=>p.name===victimName);if(k)k.kills++;if(v)v.deaths++;save();render()},
  raid(playerName){const p=DB.players.find(p=>p.name===playerName);if(p){p.raids++;save();render()}}
};

render();
</script>
