
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="sky">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>OL GANGS</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--radius:14px}
[data-theme="sky"]{--bg:#06142a;--bg2:#0a1f3d;--panel:#0d2644;--panel2:#123359;--text:#e8f4ff;--muted:#8fb4d2;--accent:#29b6f6;--accent2:#0288d1;--on-accent:#04243d;--border:#1d4a75;--danger:#ff5d6c;--ok:#3ddc97;--warn:#ffc857}
[data-theme="white"]{--bg:#eef3f8;--bg2:#e3ebf3;--panel:#ffffff;--panel2:#edf2f7;--text:#0f2233;--muted:#5d7387;--accent:#0288d1;--accent2:#01579b;--on-accent:#fff;--border:#d2dde8;--danger:#d93a4a;--ok:#1a9e66;--warn:#c98a00}
[data-theme="black"]{--bg:#050505;--bg2:#0c0c0c;--panel:#131313;--panel2:#1c1c1c;--text:#ececec;--muted:#8d8d8d;--accent:#cfd4da;--accent2:#9aa0a8;--on-accent:#0a0a0a;--border:#2b2b2b;--danger:#ff5d6c;--ok:#3ddc97;--warn:#ffc857}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Cairo',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;line-height:1.6}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit;color:inherit}
header{position:sticky;top:0;z-index:50;background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:14px;padding:10px 20px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px;cursor:pointer}
.brand b{font-family:'Oswald','Cairo',sans-serif;font-size:1.5rem;letter-spacing:2px}
.brand svg{width:40px;height:40px}
nav{display:flex;gap:4px;flex-wrap:wrap;flex:1}
nav button{background:none;border:0;padding:8px 14px;border-radius:10px;cursor:pointer;color:var(--muted);font-weight:600}
nav button:hover{background:var(--panel2);color:var(--text)}
nav button.active{background:var(--accent);color:var(--on-accent)}
.right{display:flex;align-items:center;gap:8px;position:relative}
.btn{background:var(--accent);color:var(--on-accent);border:0;padding:8px 16px;border-radius:10px;cursor:pointer;font-weight:700}
.btn:hover{filter:brightness(1.1)}
.btn.ghost{background:var(--panel2);color:var(--text);border:1px solid var(--border)}
.btn.danger{background:var(--danger);color:#fff}
.btn.sm{padding:4px 10px;font-size:.85rem;border-radius:8px}
.menu{position:absolute;top:110%;inset-inline-end:0;background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:14px;min-width:230px;display:none;box-shadow:0 12px 40px #0006}
.menu.open{display:block}
.menu h4{font-size:.85rem;color:var(--muted);margin:8px 0 6px}
.opts{display:flex;gap:6px}
.opts button{flex:1;padding:6px;border-radius:8px;border:1px solid var(--border);background:var(--panel2);cursor:pointer}
.opts button.on{outline:2px solid var(--accent)}
main{max-width:1200px;margin:0 auto;padding:24px 16px 60px}
.hero{display:grid;grid-template-columns:1fr 380px;gap:24px;align-items:center;background:linear-gradient(135deg,var(--panel),var(--bg2));border:1px solid var(--border);border-radius:22px;padding:28px;margin-bottom:24px}
.hero h1{font-family:'Oswald',sans-serif;font-size:3.2rem;letter-spacing:4px;line-height:1.1}
.hero h1 span{color:var(--accent)}
.hero p{color:var(--muted);margin:10px 0 18px;max-width:520px}
.hero svg{width:100%;height:auto;filter:drop-shadow(0 10px 30px #0008)}
@media(max-width:800px){.hero{grid-template-columns:1fr}.hero svg{max-width:300px;margin:auto}}
.grid{display:grid;gap:16px}
.g4{grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
.g3{grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}
.card{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:18px}
.stat{text-align:center}
.stat .n{font-size:2rem;font-weight:900;color:var(--accent)}
.stat .l{color:var(--muted);font-size:.9rem}
h2{font-size:1.4rem;margin:26px 0 12px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.tbl{width:100%;border-collapse:collapse;background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
.tbl th,.tbl td{padding:10px 12px;text-align:start;border-bottom:1px solid var(--border);font-size:.95rem}
.tbl th{background:var(--panel2);color:var(--muted);font-size:.8rem}
.tbl tr:last-child td{border-bottom:0}
.tbl tr.click{cursor:pointer}.tbl tr.click:hover td{background:var(--panel2)}
.wrap{overflow-x:auto;border-radius:var(--radius)}
.bar{height:8px;background:var(--panel2);border-radius:8px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent)}
.badge{display:inline-block;padding:2px 10px;border-radius:20px;font-size:.78rem;font-weight:700;background:var(--panel2);border:1px solid var(--border)}
.badge.ok{color:var(--ok)}.badge.warn{color:var(--warn)}.badge.bad{color:var(--danger)}
.gname{display:flex;align-items:center;gap:8px;font-weight:700}
.dot{width:12px;height:12px;border-radius:50%;display:inline-block}
.tabs{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap}
.tabs button{padding:8px 18px;border-radius:10px;border:1px solid var(--border);background:var(--panel);cursor:pointer;font-weight:700}
.tabs button.on{background:var(--accent);color:var(--on-accent)}
.notice{padding:12px 16px;border-radius:var(--radius);border:1px solid var(--border);background:var(--panel2);margin-bottom:14px;font-size:.92rem}
.notice.ok{border-color:var(--ok)}.notice.bad{border-color:var(--danger)}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
input,select,textarea{background:var(--panel2);border:1px solid var(--border);border-radius:10px;padding:8px 12px;width:100%}
.modal-bg{position:fixed;inset:0;background:#000a;display:flex;align-items:center;justify-content:center;z-index:100;padding:16px}
.modal{background:var(--panel);border:1px solid var(--border);border-radius:18px;padding:22px;width:100%;max-width:440px;max-height:90vh;overflow:auto}
.modal h3{margin-bottom:14px}
.modal label{display:block;font-size:.85rem;color:var(--muted);margin:10px 0 4px}
.chk{display:flex;align-items:center;gap:8px;margin:4px 0}.chk input{width:auto}
.toast{position:fixed;bottom:24px;inset-inline-start:50%;transform:translateX(-50%);background:var(--accent);color:var(--on-accent);padding:10px 22px;border-radius:12px;font-weight:700;z-index:200}
.empty{color:var(--muted);text-align:center;padding:30px}
.pcard .big{font-size:1.6rem;font-weight:900}
footer{text-align:center;color:var(--muted);padding:20px;font-size:.85rem}
</style>
</head>
<body>
<header>
  <div class="brand" onclick="go('dash')">
    <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="46" fill="#17181b" stroke="#888" stroke-width="3"/><use href="#skull" transform="translate(-8 -2) scale(.38)"/></svg>
    <b>OL GANGS</b>
